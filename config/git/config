# Shared git configuration, linked to ~/.config/git/config.
#
# Identity, signing and credential helpers are machine specific and live in
# ~/.gitconfig (template: gitconfig.local). Git reads that file after this
# one, so it can also override anything here. ignore and attributes in this
# directory are picked up automatically.

[core]
    quotepath = false
    pager = less -R
    whitespace = trailing-space

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true
    followTags = true

[fetch]
    prune = true

[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true

[merge]
    conflictStyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = default
    mnemonicPrefix = true
    renames = true

[rerere]
    enabled = true
    autoUpdate = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[column]
    ui = auto

[commit]
    verbose = true

[help]
    autocorrect = prompt

[alias]
    lg = log --graph --pretty=tformat:'%Cred%h%Creset -%C(magenta)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    pl = pull --rebase
    addnows = !sh -c 'git diff -U0 -w --no-color "$@" | git apply --cached --ignore-whitespace --unidiff-zero -'
    find = log --pretty=\"format:%Cgreen%H %Cblue%s\" --name-status --grep

[diff "javaclass"]
      textconv = javap -c
      cachetextconv = true

[diff "odf"]
      textconv = odf2txt --break-sentences

#[diff "markdown"]
#      textconv = pandoc -t markdown_github --no-wrap --filter=PDsentences.hs

[man]
      viewer = catman

[man "catman"]
     cmd = man -P cat
